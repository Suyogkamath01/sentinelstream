# Application
SENTINELSTREAM_ENVIRONMENT=development
SENTINELSTREAM_DATA_DIR=data
SENTINELSTREAM_LOG_LEVEL=INFO

# Kafka
SENTINELSTREAM_KAFKA__BOOTSTRAP_SERVERS=localhost:9092
SENTINELSTREAM_KAFKA__CLIENT_ID=sentinelstream
SENTINELSTREAM_KAFKA__CONSUMER_GROUP=sentinelstream-risk-engine
SENTINELSTREAM_KAFKA__TOPIC_PARTITIONS=6
SENTINELSTREAM_KAFKA__REPLICATION_FACTOR=1
SENTINELSTREAM_KAFKA__AUTO_OFFSET_RESET=latest
SENTINELSTREAM_KAFKA__AUTO_CREATE_TOPICS=true
SENTINELSTREAM_KAFKA__SECURITY_PROTOCOL=PLAINTEXT
# SENTINELSTREAM_KAFKA__SASL_MECHANISMS=SCRAM-SHA-256
# SENTINELSTREAM_KAFKA__SASL_USERNAME=replace-me
# SENTINELSTREAM_KAFKA__SASL_PASSWORD=replace-me

# Spark Structured Streaming
SENTINELSTREAM_SPARK__MASTER=local[*]
SENTINELSTREAM_SPARK__CHECKPOINT_DIR=data/checkpoints/sentinelstream
SENTINELSTREAM_SPARK__BATCH_INTERVAL_SECONDS=5.0
SENTINELSTREAM_SPARK__WATERMARK_DURATION=15 minutes
SENTINELSTREAM_SPARK__STATE_TIMEOUT_DURATION=24 hours
SENTINELSTREAM_SPARK__HISTORY_RETENTION_HOURS=24.0
SENTINELSTREAM_SPARK__STARTING_OFFSETS=latest
SENTINELSTREAM_SPARK__KAFKA_CONNECTOR_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.13:4.2.0
SENTINELSTREAM_SPARK__JDBC_DRIVER_PACKAGE=org.postgresql:postgresql:42.7.5
SENTINELSTREAM_SPARK__SOURCE_TOPIC=sentinelstream.validated-transactions.v1
SENTINELSTREAM_SPARK__AUDIT_TOPIC=sentinelstream.audit.v1
SENTINELSTREAM_SPARK__INPUT_MESSAGE_KIND=validated
SENTINELSTREAM_SPARK__MODEL_VERSION=unknown
SENTINELSTREAM_SPARK__CALIBRATION_VERSION=unknown

# Persistence
SENTINELSTREAM_DATABASE__URL=postgresql+psycopg://user:password@localhost/sentinelstream
SENTINELSTREAM_REDIS__URL=redis://localhost:6379/0
SENTINELSTREAM_REDIS__ENABLED=true
SENTINELSTREAM_REDIS__FALLBACK_MAX_ENTRIES=10000

# API
SENTINELSTREAM_API__HOST=127.0.0.1
SENTINELSTREAM_API__PORT=8000
SENTINELSTREAM_API__ACCESS_TOKEN_MINUTES=30
SENTINELSTREAM_API__MAX_REQUEST_BYTES=1000000

# Security
# Production requires a 32-character secret and an explicit database URL.
# SENTINELSTREAM_SECRET_KEY=replace-with-a-long-random-secret
# SENTINELSTREAM_SECURITY__ISSUER=sentinelstream
# SENTINELSTREAM_SECURITY__AUDIENCE=sentinelstream-api
SENTINELSTREAM_SECURITY__TOKEN_REVOCATION_ENABLED=true
SENTINELSTREAM_SECURITY__PII_MASKING_ENABLED=true
SENTINELSTREAM_SECURITY__LOG_REDACTION_ENABLED=true
SENTINELSTREAM_RATE_LIMIT__ENABLED=true
SENTINELSTREAM_RATE_LIMIT__REQUESTS=120
SENTINELSTREAM_RATE_LIMIT__WINDOW_SECONDS=60
SENTINELSTREAM_RATE_LIMIT__AUTHENTICATION_REQUESTS=10
SENTINELSTREAM_RATE_LIMIT__AUTHENTICATION_WINDOW_SECONDS=60

# Hybrid fraud engine
SENTINELSTREAM_HYBRID__SUPERVISED_WEIGHT=0.40
SENTINELSTREAM_HYBRID__ANOMALY_WEIGHT=0.15
SENTINELSTREAM_HYBRID__RULES_WEIGHT=0.15
SENTINELSTREAM_HYBRID__CUSTOMER_PROFILE_WEIGHT=0.10
SENTINELSTREAM_HYBRID__MERCHANT_PROFILE_WEIGHT=0.10
SENTINELSTREAM_HYBRID__DEVICE_PROFILE_WEIGHT=0.10
SENTINELSTREAM_HYBRID__REVIEW_THRESHOLD=0.50
SENTINELSTREAM_HYBRID__BLOCK_THRESHOLD=0.85

# Streamlit dashboard
SENTINELSTREAM_DASHBOARD__API_URL=http://127.0.0.1:8000
SENTINELSTREAM_DASHBOARD__REFRESH_SECONDS=10.0
SENTINELSTREAM_DASHBOARD__REQUEST_TIMEOUT_SECONDS=5.0
SENTINELSTREAM_DASHBOARD__PAGE_SIZE=50
# Used only by the local demonstration app; keep this value outside source control.
# SENTINELSTREAM_DASHBOARD__AUTH_USERNAME=analyst
# SENTINELSTREAM_DASHBOARD__AUTH_PASSWORD=replace-me

# MLOps
SENTINELSTREAM_MLOPS__TRACKING_URI=sqlite:///mlflow.db
SENTINELSTREAM_MLOPS__EXPERIMENT_NAME=sentinelstream-fraud
SENTINELSTREAM_MLOPS__REGISTERED_MODEL_NAME=sentinelstream-fraud-model
# SENTINELSTREAM_MLOPS__TRACKING_USERNAME=replace-me
# SENTINELSTREAM_MLOPS__TRACKING_PASSWORD=replace-me
# SENTINELSTREAM_MLOPS__TRACKING_TOKEN=replace-me
SENTINELSTREAM_MLOPS__OPTUNA_TRIALS=10
SENTINELSTREAM_MLOPS__OPTUNA_TIMEOUT_SECONDS=300

# Monitoring and drift
SENTINELSTREAM_MONITORING__PROMETHEUS_ENABLED=true
SENTINELSTREAM_MONITORING__PROMETHEUS_NAMESPACE=sentinelstream
SENTINELSTREAM_MONITORING__DRIFT_REPORT_DIR=reports/drift
SENTINELSTREAM_MONITORING__FEATURE_DRIFT_THRESHOLD=0.20
SENTINELSTREAM_MONITORING__PREDICTION_DRIFT_THRESHOLD=0.20
SENTINELSTREAM_MONITORING__HEALTH_TIMEOUT_SECONDS=2.0

# Benchmarks
SENTINELSTREAM_BENCHMARK__ITERATIONS=100
SENTINELSTREAM_BENCHMARK__WARMUP_ITERATIONS=10
SENTINELSTREAM_BENCHMARK__CONCURRENCY=1
SENTINELSTREAM_BENCHMARK__TIMEOUT_SECONDS=5.0
SENTINELSTREAM_BENCHMARK__RANDOM_SEED=42

# Simulation
SENTINELSTREAM_SIMULATION__RANDOM_SEED=42
SENTINELSTREAM_SIMULATION__FRAUD_RATIO=0.05
SENTINELSTREAM_SIMULATION__DUPLICATE_RATE=0.0
SENTINELSTREAM_SIMULATION__LATE_EVENT_RATE=0.0
SENTINELSTREAM_SIMULATION__MALFORMED_RATE=0.0
SENTINELSTREAM_SIMULATION__OUT_OF_ORDER_RATE=0.0

# Reserved for later phases. Keep real values out of source control.
# SENTINELSTREAM_DATABASE_URL=postgresql+psycopg://user:password@localhost/sentinelstream
# SENTINELSTREAM_SECRET_KEY=replace-me

# Docker Compose local-development values. Replace credentials before sharing ports.
POSTGRES_DB=sentinelstream
POSTGRES_USER=sentinelstream
POSTGRES_PASSWORD=sentinelstream-dev
SENTINELSTREAM_SECRET_KEY=local-development-secret-change-me-32-chars
SENTINELSTREAM_DASHBOARD__AUTH_USERNAME=analyst
SENTINELSTREAM_DASHBOARD__AUTH_PASSWORD=sentinelstream-demo-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=sentinelstream-admin
API_PORT=8000
DASHBOARD_PORT=8501
KAFKA_UI_PORT=8080
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
SPARK_UI_PORT=8081
