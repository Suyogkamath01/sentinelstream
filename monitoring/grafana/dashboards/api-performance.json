{
  "title": "SentinelStream - API Performance",
  "uid": "sentinelstream-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests by status", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "targets": [{"expr": "sum by (status) (rate(sentinelstream_api_requests_total[5m]))", "refId": "A", "legendFormat": "{{status}}"}]},
    {"id": 2, "type": "timeseries", "title": "P95 request duration", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(sentinelstream_api_request_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p95"}]},
    {"id": 3, "type": "stat", "title": "Authentication failures", "gridPos": {"h": 4, "w": 8, "x": 0, "y": 8}, "targets": [{"expr": "sum(sentinelstream_authentication_failures_total)", "refId": "A"}]}
  ]
}
